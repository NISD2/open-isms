# open-isms self-host environment
# Copy to .env and fill in the values, then `docker compose up --build`.

# ── Database ────────────────────────────────────────────────────────────
# docker-compose.yml constructs DATABASE_URL from these for the postgres
# service; set both if you change either. Default db name: open_isms.
POSTGRES_PASSWORD=changeme
POSTGRES_DB=open_isms

# ── Auth (Auth.js / NextAuth) ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL the app is served from. http://localhost:3000 for local
# docker compose, your domain for production (https://isms.example.com).
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (magic-link sign-in) ──────────────────────────────────────────
# Auth.js Email provider sends a one-time link to the user's inbox. If
# you don't set EMAIL_SERVER, the link is logged to the container's
# stdout instead (visible via `docker compose logs app`) — convenient
# for local dev, NOT acceptable in production.
#
# For real email delivery, set EMAIL_SERVER and edit
# `lib/auth.ts:sendVerificationRequest` to wire your transport (the
# function is a no-op SMTP-stub today; swap in a Resend/SES/Postmark
# client or a `nodemailer` transport against EMAIL_SERVER).
EMAIL_SERVER=
EMAIL_FROM=no-reply@open-isms.local

# ── Optional ────────────────────────────────────────────────────────────
# Host port to bind the app on (defaults to 3000).
APP_PORT=3000
