{
  "name": "@nisd2/isms-pages",
  "version": "0.1.0",
  "description": "Shared page components for NIS 2 ISMS apps. Pages are React components imported by file-based route files in each consumer; data is fetched per-app and passed in as props.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pages/*": "./src/pages/*.tsx"
  },
  "dependencies": {
    "@nisd2/isms-lib": "workspace:*",
    "@nisd2/isms-ui": "workspace:*",
    "lucide-react": "^1.16.0"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^7.0.2"
  }
}
