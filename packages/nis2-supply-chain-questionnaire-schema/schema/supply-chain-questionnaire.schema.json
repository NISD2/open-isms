              },
              "es": {
                "type": "string",
                "minLength": 1
              },
              "pl": {
                "type": "string",
                "minLength": 1
              },
              "cs": {
                "type": "string",
                "minLength": 1
              },
              "pt": {
                "type": "string",
                "minLength": 1
              },
              "ro": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "en",
              "de"
            ],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
                "minLength": 1
              },
              "it": {
