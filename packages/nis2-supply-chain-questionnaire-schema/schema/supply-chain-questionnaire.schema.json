            "type": "string",
            "enum": [
              "profile",
              "security_practices",
              "saas_technical",
              "on_prem_technical",
              "pro_services",
              "managed_services"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "text",
              "email",
              "phone",
              "url",
              "domain",
              "country",
              "boolean",
              "enum",
              "integer"
            ]
          },
          "options": {
            "type": "array",
