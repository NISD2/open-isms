              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "de": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "it": {
                      "type": "string",
                      "minLength": 1
                    },
                    "es": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pl": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cs": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pt": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ro": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "en",
                    "de"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "label": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "de": {
                "type": "string",
                "minLength": 1
              },
              "fr": {
                "type": "string",
