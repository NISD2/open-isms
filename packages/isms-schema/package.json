{
  "name": "@nisd2/isms-schema",
  "version": "0.1.0",
  "description": "ISMS database schema — process tracking tables (audit-log, evidence, sign-off-history, etc.) for NIS 2 / GRC apps. Extends @nisd2/grc-data-model entity model.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./enums": "./src/enums.ts",
    "./tables/*": "./src/tables/*.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nisd2/grc-data-model": "workspace:*",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9",
    "pg": "^8.13.1",
    "typescript": "^5.7.3"
  }
}
