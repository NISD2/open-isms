node_modules
.next
.git
.gitignore
.github

# Secrets — never let any of these enter the build context, even
# transitively into the builder stage layer cache.
.env*
!.env.example
google-service-account.json
*.pem
*.key
*.p12
*.pfx
**/credentials.json
**/service-account*.json

# Dev/IDE
.vscode
.idea
.DS_Store
*.swp
.cache

# Local Claude state
.claude/

# Test / coverage artifacts
coverage
.nyc_output
*.lcov

# Build outputs from workspace packages (force fresh install in container)
packages/*/dist
packages/*/.turbo
packages/*/node_modules

# Exception: this package's dist/ IS the consumed artifact. Its package.json
# main points at ./dist/index.js, so the build needs dist present. The other
# workspace packages consume from src/ via transpilePackages so dist there
# is genuinely throw-away.
!packages/nis2-supply-chain-questionnaire-schema/dist

# TS build cache (regenerated)
*.tsbuildinfo
