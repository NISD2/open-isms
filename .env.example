# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nis2

# Auth (required)
AUTH_SECRET=generate-a-random-secret-here

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 — evidence uploads
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.example
# Set to any value to disable email sending
# DISABLE_EMAIL=1

# AI — xAI (Grok) for LLM features
XAI_API_KEY=

# Cron job secret (Bearer token for /api/cron/deadlines)
CRON_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3026

# Platform admin emails (comma-separated). These accounts get cross-tenant
# admin access at /platform-admin and receive new-signup alerts. Leave
# unset for self-hosters with no platform-admin tier.
PLATFORM_ADMIN_EMAILS=

# Support contact shown in /email/unsubscribed and the course-reminder
# cron's reply-to. Defaults to support@example.com if unset.
SUPPORT_EMAIL=
