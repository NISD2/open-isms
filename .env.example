# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nis2

# Auth (required)
AUTH_SECRET=generate-a-random-secret-here

# Public origin Auth.js derives its cookie name from. Set this whenever the
# app sits behind an external TLS terminator (reverse proxy, Coolify, Traefik).
# Without it a production build reached over plain http writes the non-secure
# cookie while the middleware looks for the __Secure- name, and no login can
# pass the default-deny. NEXTAUTH_URL is accepted as a legacy alias.
AUTH_URL=http://localhost:3026

# Google OAuth (required in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required in production. HMAC key for the GDPR erasure suppression
# fingerprint. Erasure THROWS when this is unset and NODE_ENV=production,
# rather than falling back to a committed constant.
# Generate with: openssl rand -base64 32
ERASURE_EMAIL_HASH_SALT=

# AWS S3 — evidence uploads
AWS_S3_REGION=eu-north-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3-compatible endpoint override. Set it to run evidence storage against
# MinIO or any non-AWS S3 (the local e2e stack does this). Unset for AWS.
# The value is also injected into the CSP connect-src, so uploads from the
# browser are blocked if this does not match the real storage origin.
# AWS_S3_ENDPOINT=http://localhost:9000

# Email — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.example
# Optional separate From for the newsletter (lifecycle email). Falls back to
# RESEND_FROM_EMAIL when unset. Transactional/auth email always uses RESEND_FROM_EMAIL.
# RESEND_FROM_EMAIL_NEWS=newsletter@yourdomain.example
# Set to any value to disable email sending
# DISABLE_EMAIL=1
# Local dev hard-blocks outbound email. Set this to exercise the real Resend
# path from a dev machine. Has no effect in production.
# ENABLE_EMAIL_IN_DEV=true

# AI — xAI (Grok) for LLM features
XAI_API_KEY=

# Implisense company data via RapidAPI. The applicability wizard falls back
# to manual entry without it.
RAPIDAPI_KEY=

# Cron job secret (Bearer token for /api/cron/deadlines)
CRON_SECRET=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3026

# Set to 1 once the deployment is HTTPS-only with a real certificate. Turns on
# HSTS and the CSP upgrade-insecure-requests directive. Leave unset on http
# staging URLs: HSTS pins HTTPS for two years on that hostname once anyone
# later visits it over TLS.
# CSP_UPGRADE_INSECURE=1

# Comma-separated email domains allowed into the guided journey view.
# Defaults to "*" (open to everyone). Set an explicit list only to re-narrow,
# e.g. nisd2.eu,partnerexample.de
# JOURNEY_ALLOWED_DOMAINS=*

# Dev only, and both conditions must hold: NODE_ENV must not be production AND
# this must be exactly "true". Adds a password-less Dev Login provider.
# ENABLE_DEV_AUTH=true

# Platform admin emails (comma-separated). These accounts get cross-tenant
# admin access at /platform-admin and receive new-signup alerts. Leave
# unset for self-hosters with no platform-admin tier.
PLATFORM_ADMIN_EMAILS=

# Support contact shown in /email/unsubscribed and the course-reminder
# cron's reply-to. Defaults to support@example.com if unset.
SUPPORT_EMAIL=

# Newsletter reply address (a real mailbox; replies route here). Falls back to
# SUPPORT_EMAIL. Optional throttle: messages send in bursts of NEWSLETTER_BURST_SIZE
# every NEWSLETTER_BURST_INTERVAL_MS (defaults 2 per 1000ms).
NEWSLETTER_REPLY_TO=
# NEWSLETTER_BURST_SIZE=2
# NEWSLETTER_BURST_INTERVAL_MS=1000
