{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next/**",
      "!**/node_modules/**",
      "!**/drizzle/**",
      "!**/*.min.js",
      "!bun.lock"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "overrides": [
    {
      // Rendered documents and the slide deck: fixed literal arrays, authored
      // in order, never reordered or filtered at runtime. An index IS the
      // stable identity here, and a text key would collide on two
      // identically-worded bullets.
      // The `**/` prefix is load-bearing: bare "lib/pdf/**" matched nothing,
      // so this override silently did nothing until 09.09.
      "includes": [
        "**/lib/pdf/**",
        "**/components/pitch/**",
        "**/scripts/preview-pdfs.ts",
        "**/scripts/export-demo-ordner.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  }
}
