{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!**/drizzle",
      "!**/*.min.js",
      "!bun.lock",
      // Static assets only, no JS or CSS. Biome's a11y rules assume SVG inlined
      // into JSX, where a <title> child names the element. These files are served
      // to <img src>, whose alt attribute supplies the accessible name instead, so
      // the rule cannot be satisfied here and "fixing" it would mean editing
      // third-party brand marks. Never linted before only because lint:ci checks
      // changed files and nothing under public/ had changed.
      "!public"
    ]
  },
  // Without this, Biome cannot parse either globals.css: Tailwind v4's
  // @plugin / @custom-variant / @theme are a parse error, and a parse error
  // has no autofix and no biome-ignore form. Anyone editing a theme token
  // would have hit a failure they could only clear by editing lint config.
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 90
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "overrides": [
    {
      // Rendered documents and the slide deck: fixed literal arrays, authored
      // in order, never reordered or filtered at runtime. An index IS the
      // stable identity here, and a text key would collide on two
      // identically-worded bullets.
      // These globs are anchored at the repository root deliberately. A `**/`
      // prefix would also match packages/*/components/pitch/** and
      // apps/*/components/pitch/**, switching the rule off in trees nobody
      // meant to exempt.
      "includes": [
        "lib/pdf/**",
        "components/pitch/**",
        "scripts/preview-pdfs.ts",
        "scripts/export-demo-ordner.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      // The Durchgang core is a package in all but name: pure data and rules, reached only
      // through lib/durchgang/index.ts. Rendering, requests and the database stay outside, so
      // moving it into packages/ later is a move and not a rewrite. Row types come from
      // @/schema/types; the tables themselves stay out. Tests are exempt: they are never bundled.
      "includes": ["lib/durchgang/**", "!lib/durchgang/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-dom",
                      "react/**",
                      "next",
                      "next/**",
                      "next-intl",
                      "next-intl/**",
                      "drizzle-orm",
                      "drizzle-orm/**",
                      "@/schema",
                      "@/schema/tables/**",
                      "@/schema/modules/**",
                      "@nisd2/isms-schema",
                      "@nisd2/isms-schema/**",
                      "@nisd2/grc-data-model/schema",
                      "@/app/**",
                      "@/components/**",
                      "@/server/**",
                      "@/lib/db",
                      "@/lib/db/**",
                      "@/lib/trpc/**"
                    ],
                    "message": "lib/durchgang is pure: no rendering, requests or database."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  }
}
