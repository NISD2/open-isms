{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": [
        "./packages/isms-ui/src/components/ui/*"
      ],
      "@/hooks/use-mobile": [
        "./packages/isms-ui/src/hooks/use-mobile.ts"
      ],
      "@/*": [
        "./*"
      ],
      "@/schema": [
        "./schema/index.ts"
      ],
      "@/schema/*": [
        "./schema/*"
      ],
      "@nisd2/grc-data-model": [
        "./packages/grc-data-model/src/index.ts"
      ],
      "@nisd2/grc-data-model/*": [
        "./packages/grc-data-model/src/*"
      ],
      "@nisd2/isms-schema": [
        "./packages/isms-schema/src/index.ts"
      ],
      "@nisd2/isms-schema/*": [
        "./packages/isms-schema/src/*"
      ],
      "@nisd2/incident-notification-schema": [
        "./packages/incident-notification-schema/src/index.ts"
      ],
      "@nisd2/incident-notification-schema/*": [
        "./packages/incident-notification-schema/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    "scripts/publish-all.ts",
    "scripts/audit-dep-graph.ts",
    "scripts/i18n",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
