{
  "name": "nis2-compliance",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3026",
    "dev:turbo": "next dev --turbopack",
    "schedule:pages": "bun run scripts/schedule-pages.ts",
    "schedule:pages:dry": "bun run scripts/schedule-pages.ts --dry",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:generate:grc": "bun run --env-file=$PWD/.env --cwd packages/grc-data-model db:generate",
    "db:generate:isms": "bun run --env-file=$PWD/.env --cwd packages/isms-schema db:generate",
    "db:migrate": "bun run --env-file=$PWD/.env --cwd packages/grc-data-model db:migrate && bun run --env-file=$PWD/.env --cwd packages/isms-schema db:migrate && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run drizzle/seed.ts",
    "index-urls": "bun run scripts/index-urls.ts",
    "generate:guidance": "bun run scripts/generate-guidance.ts",
    "i18n:translate": "bun --env-file=.env run scripts/i18n/translate.ts",
    "i18n:translate:dry": "bun run scripts/i18n/translate.ts --dry-run",
    "email:dev": "email dev --dir lib/mail/templates --port 3027",
    "screenshots": "bun scripts/screenshot-pitch.ts",
    "og": "og-shot"
  },
  "dependencies": {
    "@ai-sdk/xai": "^4.0.6",
    "@aws-sdk/client-s3": "^3.985.0",
    "@aws-sdk/s3-request-presigner": "^3.985.0",
    "@base-ui/react": "^1.1.0",
    "@calcom/embed-react": "^1.5.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@nisd2/grc-data-model": "workspace:*",
    "@nisd2/incident-notification-schema": "workspace:*",
    "@nisd2/isms-schema": "workspace:*",
    "@nisd2/isms-trpc": "workspace:*",
    "@nisd2/isms-lib": "workspace:*",
    "@nisd2/isms-messages": "workspace:*",
    "@nisd2/isms-ui": "workspace:*",
    "@nisd2/nis2-gap-assessment-schema": "github:NISD2/nis2-gap-assessment-schema#v2.0.3",
    "@nisd2/nis2-supply-chain-questionnaire-schema": "workspace:*",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.6",
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.65.0",
    "@trpc/client": "^11.1.0",
    "@trpc/next": "^11.1.0",
    "@trpc/react-query": "^11.1.0",
    "@trpc/server": "^11.1.0",
    "@uidotdev/usehooks": "^2.4.1",
    "ai": "^7.0.15",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.3.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.20.0",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.11.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.19.0",
    "pg": "^8.13.1",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.6.2",
    "recharts": "^3.7.0",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unpdf": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/hast": "^3.0.4",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^26.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.9",
    "google-auth-library": "^10.5.0",
    "og-shot": "^0.4.0",
    "playwright": "^1.60.0",
    "react-email": "6.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "yaml": "^2.8.3"
  },
  "trustedDependencies": [
    "@nisd2/nis2-gap-assessment-schema",
    "@nisd2/nis2-supply-chain-questionnaire-schema"
  ],
  "browserslist": [
    "chrome >= 90",
    "firefox >= 90",
    "safari >= 15",
    "edge >= 90"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
